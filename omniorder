<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>OmniOrder — Holy Cross Campus Pre-ordering</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --primary: #e86a2e;
      --primary-light: #f5a07a;
      --primary-dark: #c4521a;
      --primary-bg: #fff5f0;
      --primary-5: rgba(232,106,46,0.07);
      --primary-20: rgba(232,106,46,0.20);
      --primary-shadow: rgba(232,106,46,0.25);
      --bg: #fdf8f5;
      --card: #ffffff;
      --border: #f0e6de;
      --foreground: #1a1208;
      --muted: #f4ede8;
      --muted-fg: #9a7a6a;
      --text: #2d1a0e;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── NAV ── */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(253,248,245,0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      height: 64px;
      display: flex;
      align-items: center;
    }
    .nav-inner {
      max-width: 960px;
      margin: 0 auto;
      padding: 0 20px;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .nav-logo {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 800;
      font-size: 1.15rem;
      color: var(--primary);
      text-decoration: none;
      cursor: pointer;
    }
    .nav-logo-icon {
      width: 32px; height: 32px;
      border-radius: 10px;
      background: var(--primary);
      color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-weight: 900; font-size: 1rem;
      box-shadow: 0 2px 8px var(--primary-shadow);
    }
    .nav-actions { display: flex; align-items: center; gap: 8px; }
    .btn-ghost {
      background: none; border: none; font-family: inherit;
      font-size: 0.9rem; font-weight: 600;
      color: var(--muted-fg); cursor: pointer;
      padding: 8px 14px; border-radius: 10px;
      transition: background .15s, color .15s;
    }
    .btn-ghost:hover { background: var(--muted); color: var(--text); }
    .btn-ghost.active { background: var(--muted); color: var(--text); }
    .cart-btn {
      position: relative; display: flex; align-items: center; gap: 6px;
      background: none; border: 1.5px solid var(--border); font-family: inherit;
      font-size: 0.9rem; font-weight: 600; color: var(--text);
      cursor: pointer; padding: 8px 16px; border-radius: 999px;
      transition: background .15s, border-color .15s, color .15s;
    }
    .cart-btn:hover { background: var(--primary-5); border-color: var(--primary); color: var(--primary); }
    .cart-badge {
      position: absolute; top: -8px; right: -8px;
      background: var(--primary); color: #fff;
      font-size: 0.65rem; font-weight: 800;
      min-width: 18px; height: 18px; border-radius: 999px;
      display: none; align-items: center; justify-content: center;
      border: 2px solid var(--bg); padding: 0 4px;
    }
    .cart-badge.visible { display: flex; }

    /* ── PAGES ── */
    .page { display: none; flex: 1; }
    .page.active { display: flex; flex-direction: column; }

    /* ── HOME ── */
    #page-home {
      align-items: center; justify-content: center;
      padding: 48px 20px;
    }
    .home-inner {
      max-width: 960px; width: 100%; margin: 0 auto;
    }
    .home-hero { text-align: center; max-width: 720px; margin: 0 auto 80px; }
    .badge-pill {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--primary-5); border: 1px solid var(--primary-20);
      color: var(--primary); font-size: 0.8rem; font-weight: 600;
      padding: 6px 14px; border-radius: 999px; margin-bottom: 24px;
    }
    .badge-pill svg { width: 14px; height: 14px; }
    .hero-title {
      font-size: clamp(2.4rem, 7vw, 4.5rem);
      font-weight: 900; line-height: 1.05;
      letter-spacing: -0.03em;
      color: var(--foreground); margin-bottom: 20px;
    }
    .hero-title .accent { color: var(--primary); }
    .hero-sub {
      font-size: 1.1rem; color: var(--muted-fg);
      line-height: 1.7; margin-bottom: 36px;
      max-width: 540px; margin-left: auto; margin-right: auto;
    }
    .hero-ctas { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .btn-primary {
      background: var(--primary); color: #fff;
      border: none; font-family: inherit; font-size: 1rem; font-weight: 700;
      padding: 14px 32px; border-radius: 999px; cursor: pointer;
      box-shadow: 0 4px 16px var(--primary-shadow);
      transition: background .15s, box-shadow .15s, transform .1s;
    }
    .btn-primary:hover { background: var(--primary-dark); box-shadow: 0 6px 24px var(--primary-shadow); transform: translateY(-1px); }
    .btn-secondary {
      background: var(--muted); color: var(--text);
      border: none; font-family: inherit; font-size: 1rem; font-weight: 700;
      padding: 14px 32px; border-radius: 999px; cursor: pointer;
      transition: background .15s;
    }
    .btn-secondary:hover { background: #e8ddd8; }
    .features-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 24px;
    }
    .feature-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 24px; padding: 32px; text-align: center;
      display: flex; flex-direction: column; align-items: center;
      box-shadow: 0 1px 4px rgba(0,0,0,0.04);
      animation: fadeUp .5s ease both;
    }
    .feature-card:nth-child(2) { animation-delay: .1s; }
    .feature-card:nth-child(3) { animation-delay: .2s; }
    .feature-icon {
      width: 60px; height: 60px; border-radius: 16px;
      background: var(--primary-5); display: flex; align-items: center;
      justify-content: center; margin-bottom: 20px;
    }
    .feature-icon svg { width: 28px; height: 28px; color: var(--primary); stroke: var(--primary); fill: none; }
    .feature-title { font-size: 1.1rem; font-weight: 800; margin-bottom: 8px; }
    .feature-desc { font-size: 0.9rem; color: var(--muted-fg); line-height: 1.6; }

    /* ── MENU ── */
    #page-menu { padding-bottom: 120px; }
    .page-content { max-width: 960px; margin: 0 auto; padding: 32px 20px; width: 100%; }
    .page-header { margin-bottom: 28px; }
    .page-title { font-size: 1.9rem; font-weight: 900; margin-bottom: 4px; }
    .page-sub { color: var(--muted-fg); font-size: 0.95rem; }
    .categories {
      display: flex; gap: 10px; overflow-x: auto; padding-bottom: 16px;
      margin-bottom: 24px; scrollbar-width: none;
    }
    .categories::-webkit-scrollbar { display: none; }
    .cat-btn {
      white-space: nowrap; padding: 10px 20px; border-radius: 999px;
      border: none; font-family: inherit; font-size: 0.9rem; font-weight: 700;
      cursor: pointer; transition: all .15s; flex-shrink: 0;
      background: var(--muted); color: var(--muted-fg);
    }
    .cat-btn.active { background: var(--primary); color: #fff; box-shadow: 0 2px 10px var(--primary-shadow); }
    .cat-btn:hover:not(.active) { background: #e8ddd8; color: var(--text); }
    .menu-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 20px;
    }
    .menu-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 24px; padding: 20px; display: flex; flex-direction: column;
      box-shadow: 0 1px 4px rgba(0,0,0,0.04);
      transition: box-shadow .2s;
      animation: fadeUp .25s ease both;
    }
    .menu-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
    .menu-card-top { flex: 1; margin-bottom: 16px; }
    .menu-card-header {
      display: flex; justify-content: space-between; align-items: flex-start;
      gap: 12px; margin-bottom: 6px;
    }
    .menu-item-name { font-weight: 800; font-size: 1rem; line-height: 1.3; }
    .menu-item-price { font-weight: 800; color: var(--primary); white-space: nowrap; font-size: 1rem; }
    .menu-item-desc { font-size: 0.82rem; color: var(--muted-fg); line-height: 1.5; }
    .menu-card-footer { border-top: 1px solid var(--border); padding-top: 14px; }
    .btn-add {
      width: 100%; background: var(--muted); color: var(--text);
      border: none; font-family: inherit; font-size: 0.9rem; font-weight: 700;
      padding: 10px; border-radius: 999px; cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 6px;
      transition: background .15s;
    }
    .btn-add:hover { background: #e8ddd8; }
    .qty-controls {
      display: flex; align-items: center; justify-content: space-between;
      background: var(--primary-5); border-radius: 999px; padding: 4px;
    }
    .qty-btn {
      width: 32px; height: 32px; border-radius: 999px; border: none;
      background: none; color: var(--primary); font-size: 1.1rem; font-weight: 700;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: background .1s;
    }
    .qty-btn:hover { background: var(--primary-20); }
    .qty-count { font-weight: 800; font-size: 1rem; min-width: 28px; text-align: center; }

    /* Floating cart */
    .float-cart {
      position: fixed; bottom: 24px; left: 0; right: 0; z-index: 50;
      display: flex; justify-content: center; padding: 0 20px;
      pointer-events: none;
      transition: transform .3s cubic-bezier(.34,1.56,.64,1), opacity .3s;
      transform: translateY(120px); opacity: 0;
    }
    .float-cart.visible { transform: translateY(0); opacity: 1; }
    .float-cart-inner {
      background: var(--foreground); color: #fff;
      border-radius: 999px; padding: 8px 8px 8px 24px;
      display: flex; align-items: center; justify-content: space-between;
      width: 100%; max-width: 460px; pointer-events: all;
      box-shadow: 0 8px 32px rgba(26,18,8,0.3);
    }
    .float-cart-info .items-label { font-weight: 800; font-size: 0.95rem; }
    .float-cart-info .subtotal-label { font-size: 0.8rem; opacity: 0.75; font-weight: 600; }
    .btn-checkout {
      background: var(--primary); color: #fff; border: none;
      font-family: inherit; font-size: 0.95rem; font-weight: 800;
      padding: 12px 24px; border-radius: 999px; cursor: pointer;
      transition: background .15s;
    }
    .btn-checkout:hover { background: var(--primary-dark); }

    /* ── CHECKOUT ── */
    .checkout-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
    }
    @media (min-width: 768px) {
      .checkout-grid { grid-template-columns: 7fr 5fr; }
    }
    .card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 24px; padding: 28px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    }
    .card-title { font-size: 1.15rem; font-weight: 800; margin-bottom: 20px; }
    .order-item {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 0; border-bottom: 1px solid var(--border);
    }
    .order-item:last-child { border-bottom: none; }
    .order-item-info { flex: 1; padding-right: 16px; }
    .order-item-name { font-weight: 700; font-size: 0.95rem; }
    .order-item-price-unit { font-size: 0.8rem; color: var(--primary); font-weight: 700; }
    .order-item-qty {
      display: flex; align-items: center; gap: 10px;
      background: var(--muted); border-radius: 999px; padding: 4px 8px;
      border: 1px solid var(--border);
    }
    .order-qty-btn {
      width: 26px; height: 26px; border-radius: 999px; border: none;
      background: none; font-size: 1rem; font-weight: 700;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: background .1s; color: var(--text);
    }
    .order-qty-btn:hover { background: var(--card); }
    .order-item-total { font-weight: 800; min-width: 60px; text-align: right; padding-left: 16px; }
    .form-group { margin-bottom: 18px; }
    .form-label { display: block; font-size: 0.85rem; font-weight: 700; margin-bottom: 6px; color: var(--text); }
    .form-input {
      width: 100%; padding: 11px 14px; border-radius: 12px;
      border: 1.5px solid var(--border); background: var(--bg);
      font-family: inherit; font-size: 0.95rem; color: var(--text);
      transition: border-color .15s;
      outline: none;
    }
    .form-input:focus { border-color: var(--primary); }
    .form-input::placeholder { color: var(--muted-fg); }
    .total-row {
      display: flex; justify-content: space-between; align-items: center;
      padding: 8px 0;
    }
    .total-row.sub { font-size: 0.9rem; color: var(--muted-fg); }
    .total-row.grand { font-weight: 800; font-size: 1.2rem; border-top: 1px solid var(--border); padding-top: 16px; margin-top: 8px; }
    .total-row.grand .grand-amount { color: var(--primary); }
    .btn-place {
      width: 100%; background: var(--primary); color: #fff;
      border: none; font-family: inherit; font-size: 1rem; font-weight: 800;
      padding: 16px; border-radius: 999px; cursor: pointer; margin-top: 20px;
      box-shadow: 0 4px 16px var(--primary-shadow);
      transition: background .15s, transform .1s;
    }
    .btn-place:hover { background: var(--primary-dark); transform: translateY(-1px); }
    .back-btn {
      display: inline-flex; align-items: center; gap: 6px;
      background: none; border: none; font-family: inherit;
      font-size: 0.85rem; font-weight: 600; color: var(--muted-fg);
      cursor: pointer; padding: 0; margin-bottom: 20px;
      transition: color .15s;
    }
    .back-btn:hover { color: var(--text); }
    .empty-state {
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; padding: 80px 20px; text-align: center;
    }
    .empty-icon {
      width: 80px; height: 80px; border-radius: 999px;
      background: var(--muted); display: flex; align-items: center;
      justify-content: center; margin-bottom: 20px;
    }
    .empty-icon svg { width: 36px; height: 36px; stroke: var(--muted-fg); fill: none; opacity: 0.5; }
    .empty-title { font-size: 1.4rem; font-weight: 800; margin-bottom: 8px; }
    .empty-sub { color: var(--muted-fg); margin-bottom: 24px; }

    /* ── ORDER STATUS ── */
    #page-order-status { align-items: stretch; }
    .status-content { max-width: 600px; margin: 0 auto; padding: 32px 20px 80px; width: 100%; }
    .status-header { text-align: center; margin-bottom: 36px; }
    .order-id { color: var(--muted-fg); font-size: 0.9rem; margin-top: 4px; }
    .ready-banner {
      background: var(--primary); color: #fff;
      border-radius: 24px; padding: 28px; text-align: center;
      margin-bottom: 28px; box-shadow: 0 6px 24px var(--primary-shadow);
      display: none;
    }
    .ready-banner.show { display: block; animation: popIn .4s cubic-bezier(.34,1.56,.64,1); }
    .ready-icon {
      width: 64px; height: 64px; border-radius: 999px;
      background: rgba(255,255,255,0.2); display: flex;
      align-items: center; justify-content: center; margin: 0 auto 16px;
    }
    .ready-icon svg { width: 32px; height: 32px; stroke: #fff; fill: none; }
    .ready-title { font-size: 1.4rem; font-weight: 900; margin-bottom: 8px; }
    .ready-name {
      display: inline-block; background: rgba(255,255,255,0.2);
      padding: 4px 14px; border-radius: 8px; font-weight: 800; font-size: 1.05rem;
      margin-top: 8px;
    }
    .tracker-card { margin-bottom: 24px; }
    .tracker-steps { position: relative; padding-left: 0; }
    .tracker-step {
      display: flex; align-items: flex-start; gap: 20px; position: relative;
      padding-bottom: 36px;
    }
    .tracker-step:last-child { padding-bottom: 0; }
    .step-line {
      position: absolute; left: 22px; top: 44px; bottom: 0;
      width: 2px; background: var(--border); border-radius: 2px;
    }
    .step-line-fill {
      position: absolute; top: 0; left: 0; right: 0;
      background: var(--primary); border-radius: 2px;
      transition: height 1s ease;
      height: 0%;
    }
    .tracker-step:last-child .step-line { display: none; }
    .step-dot {
      width: 44px; height: 44px; border-radius: 999px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center; z-index: 1;
      background: var(--muted); color: var(--muted-fg);
      transition: background .5s, color .5s, box-shadow .5s;
    }
    .step-dot svg { width: 22px; height: 22px; stroke: currentColor; fill: none; }
    .step-dot.done, .step-dot.current { background: var(--primary); color: #fff; box-shadow: 0 2px 12px var(--primary-shadow); }
    .step-body { padding-top: 8px; }
    .step-label {
      font-weight: 800; font-size: 1rem;
      color: var(--muted-fg); transition: color .5s;
    }
    .step-label.done, .step-label.current { color: var(--text); }
    .step-time { font-size: 0.82rem; color: var(--muted-fg); margin-top: 2px; }
    .step-time.current { color: var(--primary); font-weight: 600; }
    .order-details-card {}
    .detail-row {
      display: flex; justify-content: space-between;
      font-size: 0.9rem; padding: 6px 0;
    }
    .detail-row span:first-child { color: var(--muted-fg); }
    .detail-row span:last-child { font-weight: 600; }
    .detail-total {
      display: flex; justify-content: space-between;
      font-weight: 800; font-size: 1rem;
      padding-top: 14px; margin-top: 10px;
      border-top: 1px solid var(--border);
    }
    .detail-total span:last-child { color: var(--primary); }
    .another-order-btn {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      background: none; border: none; font-family: inherit; font-size: 0.9rem;
      font-weight: 600; color: var(--muted-fg); cursor: pointer; margin-top: 28px;
      padding: 10px; border-radius: 12px; width: 100%;
      transition: color .15s, background .15s;
    }
    .another-order-btn:hover { color: var(--text); background: var(--muted); }

    /* ── ANIMATIONS ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes popIn {
      from { opacity: 0; transform: scale(0.9); }
      to { opacity: 1; transform: scale(1); }
    }
    .anim-fadein { animation: fadeUp .45s ease both; }

    /* ── RESPONSIVE ── */
    @media (max-width: 600px) {
      .hero-title { font-size: 2.4rem; }
      .hero-ctas { flex-direction: column; align-items: stretch; }
      .btn-primary, .btn-secondary { text-align: center; }
    }

    /* SVG icons inline helper */
    .icon { display: inline-flex; align-items: center; justify-content: center; }
  </style>
</head>
<body>

<!-- ── NAVBAR ── -->
<nav>
  <div class="nav-inner">
    <div class="nav-logo" onclick="navigate('home')">
      <div class="nav-logo-icon">O</div>
      OmniOrder
    </div>
    <div class="nav-actions">
      <button class="btn-ghost" id="nav-menu-btn" onclick="navigate('menu')">Menu</button>
      <button class="cart-btn" onclick="navigate('checkout')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        Cart
        <span class="cart-badge" id="cart-badge">0</span>
      </button>
    </div>
  </div>
</nav>

<!-- ── HOME ── -->
<div class="page active" id="page-home">
  <div id="home-inner" style="display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1;padding:48px 20px;">
    <div class="home-inner">
      <div class="home-hero anim-fadein">
        <div class="badge-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          Holy Cross Campus Pre-ordering
        </div>
        <h1 class="hero-title">
          Pre-order your meal.<br>
          <span class="accent">Skip the line.</span>
        </h1>
        <p class="hero-sub">
          Turn the chaotic canteen line into a calm digital experience. Order in 60 seconds, pick up when ready. No waiting, no noise.
        </p>
        <div class="hero-ctas">
          <button class="btn-primary" onclick="navigate('menu')">Browse Menu</button>
          <button class="btn-secondary" onclick="navigate('order-status')">Track Order</button>
        </div>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="feature-title">No Waiting</div>
          <p class="feature-desc">Order ahead from class. Your food is ready when the bell rings.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
          </div>
          <div class="feature-title">Easy Ordering</div>
          <p class="feature-desc">Browse the full canteen menu on your phone with a few taps.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <div class="feature-title">Real-time Tracking</div>
          <p class="feature-desc">Know exactly when your food is being prepared and ready for pickup.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ── MENU ── -->
<div class="page" id="page-menu">
  <div class="page-content">
    <div class="page-header">
      <h1 class="page-title">Canteen Menu</h1>
      <p class="page-sub">Freshly prepared meals for the Holy Cross community.</p>
    </div>
    <div class="categories" id="categories"></div>
    <div class="menu-grid" id="menu-grid"></div>
  </div>

  <div class="float-cart" id="float-cart">
    <div class="float-cart-inner">
      <div class="float-cart-info">
        <div class="items-label" id="float-items">0 items</div>
        <div class="subtotal-label" id="float-subtotal">₱0</div>
      </div>
      <button class="btn-checkout" onclick="navigate('checkout')">Checkout</button>
    </div>
  </div>
</div>

<!-- ── CHECKOUT ── -->
<div class="page" id="page-checkout">
  <div class="page-content" id="checkout-content"></div>
</div>

<!-- ── ORDER STATUS ── -->
<div class="page" id="page-order-status">
  <div class="status-content" id="status-content"></div>
</div>

<script>
  // ── DATA ──
  const MENU_CATEGORIES = ["Rice Meals", "Snacks", "Drinks", "Desserts"];
  const MENU_ITEMS = [
    { id:"rm-1", name:"Pork Adobo Rice",       price:65, category:"Rice Meals", description:"Classic pork adobo served with garlic rice." },
    { id:"rm-2", name:"Chicken Sisig Silog",    price:75, category:"Rice Meals", description:"Sizzling chicken sisig with egg and rice." },
    { id:"rm-3", name:"Beef Tapa",              price:80, category:"Rice Meals", description:"Marinated beef strips with fried egg." },
    { id:"rm-4", name:"Tocino Rice Bowl",       price:70, category:"Rice Meals", description:"Sweet cured pork with rice and egg." },
    { id:"rm-5", name:"Fried Chicken w/ Rice",  price:60, category:"Rice Meals", description:"Crispy fried chicken leg with rice and gravy." },
    { id:"sn-1", name:"Pancit Canton",          price:40, category:"Snacks",     description:"Stir-fried noodles with veggies and calamansi." },
    { id:"sn-2", name:"Cheese Hotdog on Stick", price:25, category:"Snacks",     description:"Jumbo cheesedog on a stick." },
    { id:"sn-3", name:"Turon Pandesal",         price:30, category:"Snacks",     description:"Sweet banana and jackfruit spring roll in pandesal." },
    { id:"sn-4", name:"French Fries (BBQ)",     price:35, category:"Snacks",     description:"Crispy fries coated in BBQ powder." },
    { id:"sn-5", name:"Siomai (4pcs)",          price:30, category:"Snacks",     description:"Steamed pork dumplings with chili garlic." },
    { id:"dr-1", name:"Iced Tea",               price:20, category:"Drinks",     description:"Sweet and refreshing lemon iced tea." },
    { id:"dr-2", name:"Buko Pandan Juice",      price:25, category:"Drinks",     description:"Creamy coconut and pandan drink with jellies." },
    { id:"dr-3", name:"Sago't Gulaman",         price:30, category:"Drinks",     description:"Classic tapioca pearl and jelly cooler." },
    { id:"dr-4", name:"Bottled Water",          price:15, category:"Drinks",     description:"Purified drinking water." },
    { id:"ds-1", name:"Leche Flan",             price:20, category:"Desserts",   description:"Rich caramel custard." },
    { id:"ds-2", name:"Mango Graham",           price:35, category:"Desserts",   description:"Layered mango and cream graham dessert." },
    { id:"ds-3", name:"Halo-Halo (Mini)",       price:45, category:"Desserts",   description:"Shaved ice with mixed sweet beans and ube." },
    { id:"ds-4", name:"Turon (2pcs)",           price:25, category:"Desserts",   description:"Deep-fried banana rolls with caramel." }
  ];

  // ── CART STATE ──
  let cart = JSON.parse(localStorage.getItem('omniorder-cart') || '[]');
  let activeCategory = MENU_CATEGORIES[0];
  let statusTimers = [];

  function saveCart() {
    localStorage.setItem('omniorder-cart', JSON.stringify(cart));
    updateCartUI();
  }

  function getCartItem(id) { return cart.find(i => i.id === id); }

  function addToCart(item) {
    const existing = getCartItem(item.id);
    if (existing) { existing.quantity++; }
    else { cart.push({ ...item, quantity: 1 }); }
    saveCart();
    renderMenuGrid();
  }

  function updateQuantity(id, delta) {
    const item = getCartItem(id);
    if (!item) return;
    item.quantity += delta;
    if (item.quantity <= 0) cart = cart.filter(i => i.id !== id);
    saveCart();
    renderMenuGrid();
  }

  function clearCart() {
    cart = [];
    saveCart();
  }

  function getTotalItems() { return cart.reduce((s, i) => s + i.quantity, 0); }
  function getSubtotal()   { return cart.reduce((s, i) => s + i.price * i.quantity, 0); }

  function updateCartUI() {
    const total = getTotalItems();
    const sub = getSubtotal();

    // badge
    const badge = document.getElementById('cart-badge');
    badge.textContent = total;
    badge.classList.toggle('visible', total > 0);

    // float cart
    const fc = document.getElementById('float-cart');
    if (fc) {
      fc.classList.toggle('visible', total > 0);
      document.getElementById('float-items').textContent = total + ' ' + (total === 1 ? 'item' : 'items');
      document.getElementById('float-subtotal').textContent = '₱' + sub;
    }

    // nav menu highlight
    const menuBtn = document.getElementById('nav-menu-btn');
    if (menuBtn) menuBtn.classList.toggle('active', currentPage === 'menu');
  }

  // ── ROUTING ──
  let currentPage = 'home';

  function navigate(page) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById('page-' + page).classList.add('active');
    currentPage = page;
    window.scrollTo(0, 0);

    if (page === 'menu')         renderMenu();
    if (page === 'checkout')     renderCheckout();
    if (page === 'order-status') renderOrderStatus();
    updateCartUI();
  }

  // ── MENU ──
  function renderMenu() {
    renderCategories();
    renderMenuGrid();
    updateCartUI();
  }

  function renderCategories() {
    const el = document.getElementById('categories');
    el.innerHTML = MENU_CATEGORIES.map(cat => `
      <button class="cat-btn ${cat === activeCategory ? 'active' : ''}"
        onclick="setCategory('${cat}')">${cat}</button>
    `).join('');
  }

  function setCategory(cat) {
    activeCategory = cat;
    renderCategories();
    renderMenuGrid();
  }

  function renderMenuGrid() {
    const items = MENU_ITEMS.filter(i => i.category === activeCategory);
    const el = document.getElementById('menu-grid');
    el.innerHTML = items.map((item, idx) => {
      const cartItem = getCartItem(item.id);
      const controlsHtml = cartItem
        ? `<div class="qty-controls">
            <button class="qty-btn" onclick="updateQuantity('${item.id}', -1)">−</button>
            <span class="qty-count">${cartItem.quantity}</span>
            <button class="qty-btn" onclick="updateQuantity('${item.id}', 1)">+</button>
           </div>`
        : `<button class="btn-add" onclick="addToCart(${JSON.stringify(item).replace(/"/g, '&quot;')})">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add to Cart
           </button>`;
      return `
        <div class="menu-card" style="animation-delay:${idx * 0.04}s">
          <div class="menu-card-top">
            <div class="menu-card-header">
              <span class="menu-item-name">${item.name}</span>
              <span class="menu-item-price">₱${item.price}</span>
            </div>
            <p class="menu-item-desc">${item.description}</p>
          </div>
          <div class="menu-card-footer">${controlsHtml}</div>
        </div>`;
    }).join('');
    updateCartUI();
  }

  // ── CHECKOUT ──
  function renderCheckout() {
    const el = document.getElementById('checkout-content');
    if (cart.length === 0) {
      el.innerHTML = `
        <div class="empty-state">
          <div class="empty-icon">
            <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
          </div>
          <div class="empty-title">Your cart is empty</div>
          <p class="empty-sub">Looks like you haven't added anything yet.</p>
          <button class="btn-primary" onclick="navigate('menu')">Browse Menu</button>
        </div>`;
      return;
    }
    const sub = getSubtotal();
    el.innerHTML = `
      <button class="back-btn" onclick="navigate('menu')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Menu
      </button>
      <h1 class="page-title" style="margin-bottom:28px">Checkout</h1>
      <div class="checkout-grid">
        <div>
          <div class="card">
            <div class="card-title">Order Summary (${getTotalItems()} items)</div>
            <div id="order-items-list">
              ${cart.map(item => `
                <div class="order-item" id="oi-${item.id}">
                  <div class="order-item-info">
                    <div class="order-item-name">${item.name}</div>
                    <div class="order-item-price-unit">₱${item.price} each</div>
                  </div>
                  <div class="order-item-qty">
                    <button class="order-qty-btn" onclick="checkoutQty('${item.id}', -1)">−</button>
                    <span style="font-weight:800;font-size:0.9rem;min-width:20px;text-align:center">${item.quantity}</span>
                    <button class="order-qty-btn" onclick="checkoutQty('${item.id}', 1)">+</button>
                  </div>
                  <div class="order-item-total">₱${item.price * item.quantity}</div>
                </div>`).join('')}
            </div>
          </div>
        </div>
        <div>
          <div class="card" style="position:sticky;top:80px">
            <div class="card-title">Your Details</div>
            <form id="checkout-form" onsubmit="placeOrder(event)">
              <div class="form-group">
                <label class="form-label" for="inp-name">Full Name</label>
                <input class="form-input" id="inp-name" required placeholder="Juan Dela Cruz" />
              </div>
              <div class="form-group">
                <label class="form-label" for="inp-grade">Grade &amp; Section</label>
                <input class="form-input" id="inp-grade" required placeholder="e.g. 10 - Rizal" />
              </div>
              <div class="form-group">
                <label class="form-label" for="inp-contact">Contact Number (Optional)</label>
                <input class="form-input" id="inp-contact" type="tel" placeholder="0912 345 6789" />
              </div>
              <div class="total-row sub" style="margin-top:16px">
                <span>Subtotal</span><span>₱${sub}</span>
              </div>
              <div class="total-row grand">
                <span>Total</span><span class="grand-amount">₱${sub}</span>
              </div>
              <button type="submit" class="btn-place">Place Order — ₱${sub}</button>
            </form>
          </div>
        </div>
      </div>`;
  }

  function checkoutQty(id, delta) {
    updateQuantity(id, delta);
    renderCheckout();
  }

  function placeOrder(e) {
    e.preventDefault();
    const name    = document.getElementById('inp-name').value;
    const grade   = document.getElementById('inp-grade').value;
    const contact = document.getElementById('inp-contact').value;
    const order = {
      items: [...cart],
      total: getSubtotal(),
      details: { name, gradeSection: grade, contact },
      timestamp: Date.now()
    };
    localStorage.setItem('omniorder-latest', JSON.stringify(order));
    clearCart();
    navigate('order-status');
  }

  // ── ORDER STATUS ──
  function renderOrderStatus() {
    statusTimers.forEach(clearTimeout);
    statusTimers = [];

    const el = document.getElementById('status-content');
    let orderData;
    try { orderData = JSON.parse(localStorage.getItem('omniorder-latest')); } catch {}

    if (!orderData) {
      el.innerHTML = `
        <div class="empty-state">
          <div class="empty-icon">
            <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
          <div class="empty-title">No active orders</div>
          <p class="empty-sub">You don't have any recent orders to track.</p>
          <button class="btn-primary" onclick="navigate('menu')">Go to Menu</button>
        </div>`;
      return;
    }

    const orderId = '#' + String(orderData.timestamp).slice(-6);

    el.innerHTML = `
      <div class="status-header">
        <h1 class="page-title">Order Status</h1>
        <p class="order-id">Order ID: ${orderId}</p>
      </div>

      <div class="ready-banner" id="ready-banner">
        <div class="ready-icon">
          <svg viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        </div>
        <div class="ready-title">YOUR ORDER IS READY!</div>
        <p style="opacity:0.9;font-size:0.9rem;margin-top:4px">Please proceed to the canteen pickup counter and show your name:</p>
        <div class="ready-name">${orderData.details.name}</div>
      </div>

      <div class="card tracker-card">
        <div class="tracker-steps" id="tracker-steps">
          ${renderTrackerSteps(0)}
        </div>
      </div>

      <div class="card order-details-card">
        <div class="card-title" style="margin-bottom:14px">Order Details</div>
        ${orderData.items.map(item => `
          <div class="detail-row">
            <span>${item.quantity}x ${item.name}</span>
            <span>₱${item.price * item.quantity}</span>
          </div>`).join('')}
        <div class="detail-total">
          <span>Total Paid</span>
          <span>₱${orderData.total}</span>
        </div>
      </div>

      <button class="another-order-btn" onclick="navigate('menu')">
        Make another order
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </button>`;

    let step = 0;
    const advance = (s) => {
      step = s;
      document.getElementById('tracker-steps').innerHTML = renderTrackerSteps(s);
      if (s === 2) document.getElementById('ready-banner').classList.add('show');
    };

    statusTimers.push(setTimeout(() => advance(1), 2000));
    statusTimers.push(setTimeout(() => advance(2), 7000));
  }

  const STEPS = [
    { label: "Order Received",    time: "Just now",            icon: checkCircleIcon },
    { label: "Preparing",         time: "Wait ~5-10 min",      icon: chefIcon },
    { label: "Ready for Pickup",  time: "Pick up at counter",  icon: packageIcon }
  ];

  function renderTrackerSteps(currentIdx) {
    return STEPS.map((s, i) => {
      const isPast    = i < currentIdx;
      const isCurrent = i === currentIdx;
      const lineH     = i < STEPS.length - 1
        ? (isPast ? 100 : isCurrent ? 50 : 0) : 0;
      const dotCls    = isPast ? 'done' : isCurrent ? 'current' : '';
      const lblCls    = isPast || isCurrent ? 'done' : '';
      const timeCls   = isCurrent ? 'current' : '';
      return `
        <div class="tracker-step">
          <div>
            <div class="step-dot ${dotCls}">${s.icon()}</div>
            ${i < STEPS.length - 1 ? `
              <div class="step-line">
                <div class="step-line-fill" style="height:${lineH}%"></div>
              </div>` : ''}
          </div>
          <div class="step-body">
            <div class="step-label ${lblCls}">${s.label}</div>
            <div class="step-time ${timeCls}">${s.time}</div>
          </div>
        </div>`;
    }).join('');
  }

  function checkCircleIcon() {
    return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
  }
  function chefIcon() {
    return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" y1="17" x2="18" y2="17"/></svg>`;
  }
  function packageIcon() {
    return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" y1="22" x2="12" y2="12"/></svg>`;
  }

  // ── INIT ──
  updateCartUI();
</script>
</body>
</html>
